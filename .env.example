# ---------------------------------------------------------------------------
# AI Campus Helpdesk - environment configuration
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
#
# For a hosted deployment set these as environment variables in the host's
# dashboard instead of using a `.env` file (see render.yaml).
# ---------------------------------------------------------------------------

# Which LLM provider to use: gemini | openai | ollama
LLM_PROVIDER=gemini

# Your provider API key. Never exposed to the browser - it stays server-side.
LLM_API_KEY=your-api-key-here

# The model id to call. Read from env so it can be swapped without a code change.
# Examples: gemini-3.5-flash-lite (Google), gemini-3.8-flash, gpt-4o-mini (OpenAI)
LLM_MODEL=gemini-3.5-flash-lite

# Optional fallback models, tried in order when the primary is quota-blocked
# (HTTP 429) or retired (HTTP 404). Every Gemini model has its own free-tier
# quota, so listing several spreads the questions the site can answer per minute.
# Comma separated.
# LLM_FALLBACK_MODEL=gemini-3.8-flash,gemini-2.5-flash

# How long to stay on a fallback model before re-probing the primary (ms).
# LLM_FALLBACK_HOLD_MS=600000

# Port the Express server listens on. Hosted platforms set this for you.
PORT=3000

# --- Optional -------------------------------------------------------------
# For `openai` provider: any OpenAI-compatible base URL.
# OpenAI:      https://api.openai.com/v1
# Groq:        https://api.groq.com/openai/v1
# OpenRouter:  https://openrouter.ai/api/v1
# LLM_BASE_URL=https://api.openai.com/v1

# For `ollama` provider: base URL of your local Ollama server.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Ask the provider for strict JSON output. Set to false for providers that do
# not support the `response_format` / `responseMimeType` JSON mode.
# LLM_JSON_MODE=true

# Request timeout for a single LLM call, in milliseconds.
# LLM_TIMEOUT_MS=20000

# How many times to retry a transient provider failure (429 / 5xx / network).
# LLM_MAX_RETRIES=2

# Simple per-IP rate limit on /api/chat (requests per minute).
# RATE_LIMIT_PER_MIN=30

# Longest server-side cooldown after the provider reports a quota error.
# LLM_MAX_COOLDOWN_MS=30000
